<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <!-- SkinVariables viewtype selector dialog (script-skinvariables-viewtypes.xml) -->

    <!-- Icon of the focused group -->
    <include name="DialogViewTypes_Preview_Group">
        <control type="group">
            <top>40</top>
            <left>40</left>
            <right>40</right>
            <visible>!$EXP[Exp_ViewTypes_IsViewFocused]</visible>
            <control type="image">
                <texture border="20" colordiffuse="dialog_fg_06">common/dialog.png</texture>
            </control>
            <control type="image">
                <centerleft>50%</centerleft>
                <centertop>50%</centertop>
                <width>160</width>
                <height>160</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="dialog_fg_70">$INFO[Window.Property(SkinVariables.ViewTypes.Screenshot)]</texture>
            </control>
        </control>
    </include>

    <!-- Live preview of the focused viewtype: the view drawn at full screen size and zoomed to 50% so it fills the 960x540 preview area
         (40 in from the body edges, so centred at 520,310). The include content holds the preview views, which the script fills and shows. -->
    <include name="DialogViewTypes_Preview_Live">
        <control type="group">
            <centerleft>520</centerleft>
            <centertop>310</centertop>
            <width>1920</width>
            <height>1080</height>
            <visible>$EXP[Exp_ViewTypes_IsViewFocused]</visible>
            <animation effect="zoom" end="50" center="auto" time="0" condition="true">Conditional</animation>
            <include>DialogViewTypes_Preview_Background</include>
            <control type="group">
                <include>Info_Panel_Dimensions</include>
                <include content="Info_Panel">
                    <param name="container">Container(5000).</param>
                    <param name="croplogo">Window(Home).Property(TMDbHelper.ListItem.Current.CropImage)</param>
                    <param name="visible_line">$EXP[Exp_ViewTypes_Preview_IsDetailed]</param>
                    <param name="visible_plot">$EXP[Exp_ViewTypes_Preview_IsDetailed]</param>
                    <param name="visible_meta">$EXP[Exp_ViewTypes_Preview_IsDetailed]</param>
                </include>
            </control>
            <include content="View_Line">
                <param name="visible">$EXP[Exp_ViewTypes_Preview_IsDetailed] + !$EXP[Exp_ViewTypes_Preview_IsTabs]</param>
            </include>
            <include content="View_Line">
                <param name="top">260</param>
                <param name="visible">!$EXP[Exp_ViewTypes_Preview_IsDetailed] + !$EXP[Exp_ViewTypes_Preview_IsTabs]</param>
            </include>
            <nested />
        </control>
    </include>

    <!-- Simplified background: the blur and foreground artwork layers of Background_Main_Standard with its overlays, at the default
         flixart size. Only the background reaches the corners, so each layer takes the rounded diffuse. The blur quadrants and the
         foreground artwork use the _preview masks in extras/diffuse/flixart/1280x720, which add the rounded corner to their own masks
         and hide the part of the quadrants image that falls outside the screen. Views without the detailed info panel darken it and hide the foreground artwork, as their real views do. -->
    <include name="DialogViewTypes_Preview_Background">
        <control type="image">
            <texture colordiffuse="$VAR[ColorBackground]" diffuse="diffuse/landscape_w1040_h585.png">common/white.png</texture>
        </control>
        <include content="Object_Control" condition="$EXP[Exp_TMDbHelper_IsBlur]">
            <param name="control">image</param>
            <top>0</top>
            <right>0</right>
            <width>2560</width>
            <height>1440</height>
            <aspectratio scalediffuse="false">scale</aspectratio>
            <texture background="true" diffuse="special://skin/extras/diffuse/flixart/1280x720/quadrants_preview.png">$VAR[Image_Background,,-tiled.jpg]</texture>
        </include>
        <include content="Object_Control" condition="!$EXP[Exp_TMDbHelper_IsBlur]">
            <param name="control">image</param>
            <aspectratio align="left" scalediffuse="false">scale</aspectratio>
            <texture background="true" diffuse="diffuse/landscape_w1040_h585.png">$VAR[Image_SimpleBackground]</texture>
        </include>
        <include content="DialogViewTypes_Preview_FlixArt" condition="$EXP[Exp_TMDbHelper_IsBlur]">
            <param name="variant">flixart_preview</param>
        </include>
        <include content="DialogViewTypes_Preview_FlixArt" condition="!$EXP[Exp_TMDbHelper_IsBlur]">
            <param name="variant">flixart_new_preview</param>
        </include>
        <control type="image">
            <texture colordiffuse="$VAR[ColorBackground]" diffuse="diffuse/landscape_w1040_h585.png">special://skin/extras/backgrounds/overlay/combined_flixart.png</texture>
        </control>
        <control type="image">
            <visible>!$EXP[Exp_ViewTypes_Preview_IsDetailed]</visible>
            <texture colordiffuse="$VAR[ColorBackground]" diffuse="diffuse/landscape_w1040_h585.png">special://skin/extras/backgrounds/overlay/combined_overlay.png</texture>
        </control>
    </include>

    <!-- Side artwork of the list view previews, from the focused item in list 5000 -->
    <variable name="Image_ViewTypes_Preview_Poster">
        <value condition="!String.IsEmpty(Container(5000).ListItem.Art(poster))">$INFO[Container(5000).ListItem.Art(poster)]</value>
        <value>$INFO[Container(5000).ListItem.Art(thumb)]</value>
    </variable>

    <variable name="Image_ViewTypes_Preview_Landscape">
        <value condition="!String.IsEmpty(Container(5000).ListItem.Art(landscape))">$INFO[Container(5000).ListItem.Art(landscape)]</value>
        <value condition="!String.IsEmpty(Container(5000).ListItem.Art(fanart))">$INFO[Container(5000).ListItem.Art(fanart)]</value>
        <value>$INFO[Container(5000).ListItem.Art(thumb)]</value>
    </variable>

    <variable name="Image_ViewTypes_Preview_Square">
        <value condition="!String.IsEmpty(Container(5000).ListItem.Art(thumb))">$INFO[Container(5000).ListItem.Art(thumb)]</value>
        <value>$INFO[Container(5000).ListItem.Art(poster)]</value>
    </variable>

    <!-- Foreground artwork of Background_FlixArt at the default flixart size -->
    <include name="DialogViewTypes_Preview_FlixArt">
        <control type="image">
            <top>0</top>
            <right>0</right>
            <width>1280</width>
            <height>720</height>
            <visible>$EXP[Exp_ViewTypes_Preview_IsDetailed]</visible>
            <aspectratio scalediffuse="false">scale</aspectratio>
            <include content="Texture_FlixArt_Foreground_Sized">
                <param name="variant">$PARAM[variant]</param>
            </include>
        </control>
    </include>

    <!-- Preview of a viewtype: its real view with the items the script copies from the window under the dialog.
         The script adds the visible condition for the viewtype to the outer group. The view list stays visible because the views hide themselves with Control.IsVisible of their list. -->
    <include name="DialogViewTypes_Preview_View">
        <control type="group">
            <nested />
            <include content="$PARAM[include]">
                <param name="id">$PARAM[id]</param>
                <param name="visible">true</param>
                <param name="image_poster">$VAR[Image_ViewTypes_Preview_Poster]</param>
                <param name="image_landscape">$VAR[Image_ViewTypes_Preview_Landscape]</param>
                <param name="image_square">$VAR[Image_ViewTypes_Preview_Square]</param>
            </include>
        </control>
    </include>

    <!-- Combined row preview: the script fills the category tabs (52 + index) and the row (53 + index) loads the focused category -->
    <include name="DialogViewTypes_Preview_Combined_Row">
        <control type="group">
            <nested />
            <include content="DialogViewTypes_Preview_Tabs">
                <param name="top">520</param>
                <param name="include">View_Combined_List_Horz</param>
                <param name="index">$PARAM[index]</param>
            </include>
            <include content="View_Row_Include">
                <param name="id">53$PARAM[index]</param>
                <param name="include">$PARAM[list]</param>
                <param name="visible">true</param>
                <param name="include_content">DialogViewTypes_Preview_Content</param>
                <param name="content_limit">$PARAM[content_limit]</param>
            </include>
        </control>
    </include>

    <!-- Combined wall preview: the script fills the category tabs (55 + index) and the wall (56 + index) loads the focused category -->
    <include name="DialogViewTypes_Preview_Combined_Wall">
        <control type="group">
            <nested />
            <include content="DialogViewTypes_Preview_Tabs">
                <param name="top">260</param>
                <param name="include">View_Combined_Wall_List_Horz</param>
                <param name="index">$PARAM[index]</param>
            </include>
            <include content="View_Wall_Include">
                <param name="id">56$PARAM[index]</param>
                <param name="include">$PARAM[list]</param>
                <param name="visible">true</param>
                <param name="include_content">DialogViewTypes_Preview_Content</param>
                <param name="content_limit">$PARAM[content_limit]</param>
            </include>
        </control>
    </include>

    <!-- Combined expanded preview: the script fills the category tabs (528) and the expanded list (538) loads the focused category -->
    <include name="DialogViewTypes_Preview_Combined_Expanded">
        <control type="group">
            <nested />
            <include content="DialogViewTypes_Preview_Tabs">
                <param name="top">260</param>
                <param name="include">View_Combined_List_Horz</param>
                <param name="index">8</param>
                <param name="include_movement">View_Combined_List_Vert_Selector_Movement</param>
            </include>
            <include content="View_528_List_Combined">
                <param name="include_content">DialogViewTypes_Preview_Content</param>
                <param name="content_limit">$PARAM[content_limit]</param>
            </include>
        </control>
    </include>

    <!-- Combined sidebar preview: the script fills the category list (527) and the expanded list (537) loads the focused category -->
    <include name="DialogViewTypes_Preview_Combined_Sidebar">
        <control type="group">
            <nested />
            <include content="View_ComboList_Include">
                <param name="id">7</param>
                <param name="visible">true</param>
                <param name="include_expanded_content">DialogViewTypes_Preview_Content</param>
                <param name="content_limit">$PARAM[content_limit]</param>
            </include>
        </control>
    </include>

    <!-- Category tabs of a combined view in place of the section line, as View_Combined_Row_Horz_Selector draws them -->
    <include name="DialogViewTypes_Preview_Tabs">
        <param name="include_movement">View_Combined_List_Horz_Selector_Movement</param>
        <definition>
            <control type="group">
                <top>$PARAM[top]</top>
                <height>40</height>
                <control type="group">
                    <left>view_pad</left>
                    <include>View_Line_Divider</include>
                </control>
                <include content="$PARAM[include]">
                    <param name="id">$PARAM[index]</param>
                    <param name="visible">true</param>
                    <param name="overlay">true</param>
                    <param name="include_movement">$PARAM[include_movement]</param>
                </include>
            </control>
        </definition>
    </include>

    <!-- Content of the combined lists: the folder of the focused category in list 5000, limited to the items the view shows in full -->
    <include name="DialogViewTypes_Preview_Content">
        <content limit="$PARAM[limit]">$INFO[Container(5000).ListItem.FolderPath]</content>
    </include>

    <!-- Selector button. The script adds the label, selected and visible tags. -->
    <include name="DialogViewTypes_Button">
        <include content="Settings_Button">
            <param name="id">$PARAM[id]</param>
            <param name="control">radiobutton</param>
            <param name="dialog">true</param>
            <nested />
        </include>
    </include>

    <!-- Viewtype button: the radio sits on the left of the label, like a selection list -->
    <include name="DialogViewTypes_Button_View">
        <include content="DialogViewTypes_Button">
            <param name="id">$PARAM[id]</param>
            <nested />
            <radioposx>-2</radioposx>
            <textoffsetx>80</textoffsetx>
        </include>
    </include>

    <!-- Group button: the radio on the right shows a triangle pointing right while collapsed and down while expanded -->
    <include name="DialogViewTypes_Button_Group">
        <include content="DialogViewTypes_Button">
            <param name="id">$PARAM[id]</param>
            <nested />
            <textureradioonfocus colordiffuse="$VAR[ColorSelected]">buttons/triangle-down.png</textureradioonfocus>
            <textureradioonnofocus colordiffuse="dialog_fg_70">buttons/triangle-down.png</textureradioonnofocus>
            <textureradioondisabled colordiffuse="dialog_fg_06">buttons/triangle-down.png</textureradioondisabled>
            <textureradioofffocus colordiffuse="$VAR[ColorSelected]">buttons/triangle-right.png</textureradioofffocus>
            <textureradiooffnofocus colordiffuse="dialog_fg_70">buttons/triangle-right.png</textureradiooffnofocus>
            <textureradiooffdisabled colordiffuse="dialog_fg_06">buttons/triangle-right.png</textureradiooffdisabled>
        </include>
    </include>

</includes>
