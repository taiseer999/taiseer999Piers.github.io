            </include>
        </definition>
    </include>

    <include name="View_Media_Poster">
        <param name="image">$VAR[Image_Poster]</param>
        <definition>
            <control type="group">
                <height>612</height>
                <width>430</width>
                <bottom>0</bottom>
                <right>0</right>
                <control type="image">
                    <include>Texture_Shadow_40</include>
                    <texture colordiffuse="main_fg_12" border="20">common/box.png</texture>
                </control>
                <control type="image">
                    <texture diffuse="diffuse/poster_w430_h612.png" background="true">$PARAM[image]</texture>
                    <fadetime>background_fadetime</fadetime>
                    <aspectratio scalediffuse="false">scale</aspectratio>
                </control>
            </control>
        </definition>
    </include>

    <include name="View_Media_Landscape">
        <param name="image">$VAR[Image_BasicList_Landscape]</param>
        <param name="diffuse">diffuse/landscape_w1088_h612.png</param>
        <param name="height">612</param>
        <param name="width">1088</param>
        <param name="pad">160</param>
        <definition>
            <control type="group">
                <height>$PARAM[height]</height>
                <width>$PARAM[width]</width>
                <bottom>0</bottom>
                <right>0</right>
                <control type="image">
                    <include>Texture_Shadow_40</include>
                    <texture colordiffuse="main_fg_12" border="20">common/box.png</texture>
                </control>
                <control type="group">
                    <include content="Object_Layout_Image_Icon">
                        <param name="diffuse">$PARAM[diffuse]</param>
                        <param name="icon">$INFO[ListItem.Icon]</param>
                        <param name="listitem">ListItem</param>
                        <param name="aspectratio">keep</param>
                        <param name="selected">false</param>
                        <param name="genre_bordersize">180</param>
                        <param name="other_bordersize">140</param>
                    </include>
                </control>
                <control type="image">
                    <texture diffuse="$PARAM[diffuse]" background="true">$PARAM[image]</texture>
                    <fadetime>background_fadetime</fadetime>
                    <aspectratio scalediffuse="false">keep</aspectratio>
                </control>
            </control>
        </definition>
    </include>

    <include name="View_MediaList_Landscape">
        <param name="visible">!$EXP[Exp_InfoDialogs]</param>
        <param name="has_poster">false</param>
        <param name="poster">$VAR[Image_Poster]</param>
        <param name="landscape">$VAR[Image_Landscape]</param>
        <definition>
            <control type="group">
                <visible>$PARAM[has_poster]</visible>
                <right>-40</right>
                <bottom>-40</bottom>
                <height>391</height>
                <control type="group">
                    <right>664</right>
                    <height>391</height>
                    <width>280</width>
                    <include content="Layout_Poster">
                        <param name="icon">$PARAM[poster]</param>
                        <param name="diffuse">diffuse/poster_w240_h351.png</param>
                        <param name="indicator">true</param>
                        <param name="item_w">240</param>
                        <param name="item_h">351</param>
                    </include>
                </control>
            </control>
            <control type="group">
                <right>-40</right>
                <bottom>-40</bottom>
                <height>391</height>
                <control type="group">
                    <right>0</right>
                    <height>391</height>
                    <width>664</width>
                    <include content="Layout_Poster">
                        <param name="icon">$PARAM[landscape]</param>
                        <param name="diffuse">diffuse/landscape_w624_h351.png</param>
                        <param name="indicator">true</param>
                        <param name="item_w">624</param>
                        <param name="item_h">351</param>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <include name="View_MediaList_Include">
        <param name="scrollbar_id">64</param>
        <param name="overlay">false</param>
        <param name="control">fixedlist</param>
        <param name="itemlayout_include">Layout_MediaList</param>
        <param name="include_content">Object_Null</param>
        <definition>

            <control type="group">
                <visible>Control.IsVisible($PARAM[id])</visible>
                <include>Dimension_Info</include>

                <nested />

                <control type="group">
                    <left>$PARAM[left]</left>
                    <right>$PARAM[right]</right>
                    <top>$PARAM[top]</top>
                    <bottom>$PARAM[bottom]</bottom>

                    <include content="List_DialogSelect">
                        <param name="id">$PARAM[id]</param>
                        <param name="textcolor">main_fg</param>
                        <param name="control">$PARAM[control]</param>
                        <param name="itemlayout_include">$PARAM[itemlayout_include]</param>
                        <param name="item_height">$PARAM[item_height]</param>
                        <param name="variation">$PARAM[variation]</param>
                        <param name="include_detailed_labels">$PARAM[include_detailed_labels]</param>
                        <param name="misc">$PARAM[misc]</param>
                        <left>-20</left>
                        <right>-60</right>
                        <onleft>600</onleft>
                        <onright>611</onright>
                        <include>Action_View_Movement_OnLeft</include>
                        <include content="Action_View_Movement_OnBack">
                            <param name="id">$PARAM[id]</param>
                            <param name="onback">True</param>
                        </include>
                        <focusposition>$PARAM[focusposition]</focusposition>
                        <movement>$PARAM[movement]</movement>
                        <pagecontrol>$PARAM[scrollbar_id]</pagecontrol>
                        <include>$PARAM[include_content]</include>
                        <visible>$PARAM[visible]</visible>
                        <viewtype label="$PARAM[viewtype_label]">list</viewtype>
                        <onfocus>ClearProperty(TMDbHelper.WidgetContainer)</onfocus>
                        <onfocus condition="![$PARAM[overlay]]">ClearProperty(Background.ShowOverlay,Home)</onfocus>
                        <onfocus condition="$PARAM[overlay]">SetProperty(Background.ShowOverlay,True,Home)</onfocus>
                        <onfocus>SetProperty(InfoPanel.FullSwitch,List,Home)</onfocus>
                    </include>
                </control>
            </control>
        </definition>
    </include>

</includes>
