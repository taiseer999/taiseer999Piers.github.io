<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <!-- ================================================================== -->
    <!--  DYNAMIC SEARCH (window 1148) - ported from AZR Omega              -->
    <!--  Upstream builds these rows with skinshortcuts v1 (searchdynamenu).-->
    <!--  This fork runs skinshortcuts v3, so the rows are static here.     -->
    <!--  Row ids: list 5000+n, title group 5900+n, title grouplist 5800+n  -->
    <!--  (the result panel 6060 and buttons 381/382 rely on 5001-5014).    -->
    <!-- ================================================================== -->

    <include name="Search_Dynamic_Widget_Row">
        <param name="n" />
        <param name="label" />
        <param name="path" />
        <param name="path2" />
        <param name="target" default="videos" />
        <param name="limit" default="$VAR[Value_Widget_Limit]" />
        <param name="listtype" default="fixedlist" />
        <param name="movement" default="7" />
        <param name="Thumbnail" default="false" />
        <param name="ThumbnailSmall" default="false" />
        <param name="Fanart" default="false" />
        <param name="FanartSmall" default="false" />
        <param name="Square" default="false" />
        <param name="SquareMiddle" default="false" />
        <param name="SquareSmall" default="false" />
        <param name="row_visible" default="true" />

        <definition>

            <!-- WIDGET - TITLE - LABEL -->

            <control type="group" id="59$PARAM[n]">
                <visible>[Integer.IsGreater(Container(50$PARAM[n]).NumItems,0) | Container(50$PARAM[n]).IsUpdating]</visible>
                <visible>$PARAM[row_visible]</visible>

                <control type="grouplist" id="58$PARAM[n]">
                    <include content="Widget_Title_Label" condition="!Skin.HasSetting(hide.widget.title)">
                        <param name="focusid" value="50$PARAM[n]" />
                        <param name="idshort" value="50$PARAM[n]" />
                        <param name="id" value="50$PARAM[n]" />
                        <param name="animation_condition" value="!Control.HasFocus(50$PARAM[n])" />
                        <param name="widget_label" value="$PARAM[label]" />
                        <param name="busy_visible" value="Integer.IsEqual(Container(50$PARAM[n]).NumItems,0) | Container(50$PARAM[n]).IsUpdating" />
                        <param name="window_search" value="true" />
                    </include>
                </control>
            </control>

            <!-- WIDGET - LIST -->

            <control type="$PARAM[listtype]" id="50$PARAM[n]">
                <include>Animation_Widget_Fade_In_Out</include>

                <include content="Def_Search_Widget_Container">
                    <param name="id" value="50$PARAM[n]" />
                    <param name="height" value="325" />
                    <param name="orientation" value="horizontal" />
                    <param name="movement" value="$PARAM[movement]" />
                    <param name="visible" value="!String.IsEmpty(Control.GetLabel(90009).index(1)) + $PARAM[row_visible]" />
                    <param name="altvisible" value="[[System.IdleTime(1) + !System.IdleTime(2) + Control.HasFocus(90009) + !String.IsEqual(Window.Property(PreviousSearchTerm),Control.GetLabel(90009).index(1))] | !String.IsEmpty(Window(Home).Property(UpdateWidgetSearch))]" />
                </include>

                <!-- ITEM LAYOUTS -->

                <include content="Def_Normal_Layout_Item">
                    <param name="shortcutsclearlogo" value="true" />
                    <param name="aspectratio" value="keep" />
                    <param name="distance" value="10" />
                    <param name="Thumbnail" value="$PARAM[Thumbnail]" />
                    <param name="Fanart" value="$PARAM[Fanart]" />
                    <param name="FanartSmall" value="$PARAM[FanartSmall]" />
                    <param name="ThumbnailSmall" value="$PARAM[ThumbnailSmall]" />
                    <param name="Square" value="$PARAM[Square]" />
                    <param name="SquareMiddle" value="$PARAM[SquareMiddle]" />
                    <param name="SquareSmall" value="$PARAM[SquareSmall]" />
                    <param name="window_search" value="true" />
                </include>

                <!-- FOCUS LAYOUTS -->

                <include content="Def_Normal_Layout_Item_Focus">
                    <param name="shortcutsid" value="50$PARAM[n]" />
                    <param name="shortcutsclearlogo" value="true" />
                    <param name="aspectratio" value="keep" />
                    <param name="distance" value="10" />
                    <param name="Thumbnail" value="$PARAM[Thumbnail]" />
                    <param name="Fanart" value="$PARAM[Fanart]" />
                    <param name="FanartSmall" value="$PARAM[FanartSmall]" />
                    <param name="ThumbnailSmall" value="$PARAM[ThumbnailSmall]" />
                    <param name="Square" value="$PARAM[Square]" />
                    <param name="SquareMiddle" value="$PARAM[SquareMiddle]" />
                    <param name="SquareSmall" value="$PARAM[SquareSmall]" />
                    <param name="window_search" value="true" />
                </include>

                <!-- CONTENT : prefix + typed term + suffix -->

                <content target="$PARAM[target]" limit="$PARAM[limit]" browse="never">$INFO[Control.GetLabel(90009).index(1),$PARAM[path],$PARAM[path2]]</content>

                <!-- MORE CONTENT -->

                <include content="Def_Widget_Item_More_Content" condition="Skin.HasSetting(enable.morewidget)">
                    <param name="id" value="50$PARAM[n]" />
                    <param name="target" value="$PARAM[target]" />
                    <param name="content" value="$INFO[Control.GetLabel(90009).index(1),$PARAM[path],$PARAM[path2]]" />
                </include>
            </control>
        </definition>
    </include>

