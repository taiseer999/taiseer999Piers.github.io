<?xml version="1.0" encoding="UTF-8"?>
<!-- ABUKARIM TOOLS – Skin Selection: skin gallery (v3.1.0.18 redesign).
     Left: portal art + live details of the focused skin. Right: 3-column
     gallery of 16:9 screenshots. Backdrop = focused skin's screenshot.
     Python contract (unchanged): panel 100, labels 9001/9002/210,
     Window.Property(background|portal_icon), ListItem.Art(thumb),
     ListItem.Property(installed|version). -->
<window>
    <defaultcontrol always="true">100</defaultcontrol>
    <controls>

        <!-- backdrop -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>$INFO[Window.Property(background)]</texture>
            <aspectratio>scale</aspectratio>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>$INFO[Container(100).ListItem.Art(thumb)]</texture>
            <aspectratio>scale</aspectratio>
            <fadetime>350</fadetime>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="E0030509">white.png</texture>
        </control>

        <!-- ── left: details panel ─────────────────────────────────────── -->
        <control type="image">
            <left>60</left><top>60</top><width>600</width><height>960</height>
            <texture colordiffuse="E60A0F1A">white.png</texture>
        </control>
        <control type="image">
            <left>60</left><top>60</top><width>300</width><height>5</height>
            <texture colordiffuse="FF1E8FFF">white.png</texture>
        </control>
        <control type="image">
            <left>360</left><top>60</top><width>300</width><height>5</height>
            <texture colordiffuse="FFFF7A1A">white.png</texture>
        </control>

        <control type="image">
            <left>225</left><top>95</top><width>270</width><height>270</height>
            <texture>$INFO[Window.Property(portal_icon)]</texture>
            <aspectratio>keep</aspectratio>
        </control>
        <control type="label" id="9001">
            <left>60</left><top>375</top><width>600</width><height>80</height>
            <font>AbkTitle</font>
            <align>center</align><aligny>center</aligny>
            <textcolor>FFFFFFFF</textcolor>
            <shadowcolor>FF1E8FFF</shadowcolor>
            <label></label>
        </control>

        <!-- focused skin: large preview + name + version + state -->
        <control type="image">
            <left>100</left><top>480</top><width>520</width><height>292</height>
            <texture colordiffuse="FF1E8FFF">white.png</texture>
        </control>
        <control type="image">
            <left>103</left><top>483</top><width>514</width><height>286</height>
            <texture>$INFO[Container(100).ListItem.Art(thumb)]</texture>
            <aspectratio>scale</aspectratio>
            <fadetime>250</fadetime>
        </control>
        <control type="label" id="210">
            <left>60</left><top>790</top><width>600</width><height>36</height>
            <font>AbkHint</font>
            <align>center</align><aligny>center</aligny>
            <textcolor>FFFF7A1A</textcolor>
            <label></label>
        </control>
        <control type="label">
            <left>90</left><top>826</top><width>540</width><height>56</height>
            <font>AbkRowBold</font>
            <align>center</align><aligny>center</aligny>
            <scroll>true</scroll>
            <textcolor>FFFFFFFF</textcolor>
            <label>$INFO[Container(100).ListItem.Label]</label>
        </control>
        <control type="label">
            <left>60</left><top>884</top><width>600</width><height>36</height>
            <font>AbkHint</font>
            <align>center</align><aligny>center</aligny>
            <textcolor>FF7F93B8</textcolor>
            <label>$INFO[Container(100).ListItem.Property(version),v]</label>
        </control>
        <control type="group">
            <left>250</left><top>930</top>
            <visible>String.IsEqual(Container(100).ListItem.Property(installed),true)</visible>
            <control type="image">
                <left>0</left><top>0</top><width>220</width><height>44</height>
                <texture colordiffuse="FF0E3B26">white.png</texture>
            </control>
            <control type="image">
                <left>0</left><top>0</top><width>6</width><height>44</height>
                <texture colordiffuse="FF33D17A">white.png</texture>
            </control>
            <control type="label">
                <left>6</left><top>0</top><width>214</width><height>44</height>
                <font>AbkHint</font>
                <align>center</align><aligny>center</aligny>
                <textcolor>FF5BF09A</textcolor>
                <label>$ADDON[plugin.program.abukarimtools 30407]</label>
            </control>
        </control>

        <!-- ── right: gallery ──────────────────────────────────────────── -->
        <control type="panel" id="100">
            <left>700</left><top>60</top><width>1180</width><height>900</height>
            <orientation>vertical</orientation>
            <onleft>100</onleft><onright>100</onright>
            <pagecontrol>-</pagecontrol>
            <scrolltime tween="cubic" easing="out">250</scrolltime>

            <itemlayout width="393" height="300">
                <control type="image">
                    <left>8</left><top>8</top><width>377</width><height>284</height>
                    <texture colordiffuse="D90C1322">white.png</texture>
                </control>
                <control type="image">
                    <left>16</left><top>16</top><width>361</width><height>203</height>
                    <texture>$INFO[ListItem.Art(thumb)]</texture>
                    <aspectratio>scale</aspectratio>
                </control>
                <control type="image">
                    <left>16</left><top>16</top><width>361</width><height>203</height>
                    <texture colordiffuse="80030509">white.png</texture>
                </control>
                <control type="label">
                    <left>26</left><top>228</top><width>305</width><height>54</height>
                    <font>AbkCard</font>
                    <aligny>center</aligny>
                    <textcolor>FF7F93B8</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="image">
                    <left>345</left><top>245</top><width>20</width><height>20</height>
                    <texture colordiffuse="FF33D17A">white.png</texture>
                    <visible>String.IsEqual(ListItem.Property(installed),true)</visible>
                </control>
            </itemlayout>

            <focusedlayout width="393" height="300">
                <control type="group">
                    <animation effect="zoom" start="95" end="100" center="196,150" time="180" tween="cubic" easing="out">Focus</animation>
                    <control type="image">
                        <left>3</left><top>3</top><width>387</width><height>147</height>
                        <texture colordiffuse="FF1E8FFF">white.png</texture>
                    </control>
                    <control type="image">
                        <left>3</left><top>150</top><width>387</width><height>147</height>
                        <texture colordiffuse="FFFF7A1A">white.png</texture>
                    </control>
                    <control type="image">
                        <left>8</left><top>8</top><width>377</width><height>284</height>
                        <texture colordiffuse="FF0A0F1A">white.png</texture>
                    </control>
                    <control type="image">
                        <left>14</left><top>14</top><width>365</width><height>205</height>
                        <texture>$INFO[ListItem.Art(thumb)]</texture>
                        <aspectratio>scale</aspectratio>
                    </control>
                    <control type="label">
                        <left>24</left><top>228</top><width>307</width><height>54</height>
                        <font>AbkCardBold</font>
                        <aligny>center</aligny>
                        <scroll>true</scroll>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="image">
                        <left>345</left><top>245</top><width>20</width><height>20</height>
                        <texture colordiffuse="FF33D17A">white.png</texture>
                        <visible>String.IsEqual(ListItem.Property(installed),true)</visible>
                    </control>
                </control>
            </focusedlayout>
        </control>

        <!-- footer hint -->
        <control type="label" id="9002">
            <left>700</left><top>972</top><width>1180</width><height>40</height>
            <font>AbkHint</font>
            <align>center</align><aligny>center</aligny>
            <textcolor>FFAFC3E6</textcolor>
            <label></label>
        </control>

    </controls>
</window>
