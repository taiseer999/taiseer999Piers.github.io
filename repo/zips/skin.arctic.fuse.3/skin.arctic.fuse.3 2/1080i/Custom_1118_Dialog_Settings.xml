<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1118">

    <defaultcontrol always="true">8000</defaultcontrol>
    <onload>SetProperty(TMDbHelper.ContextMenu,True)</onload>
    <!-- ABUKARIM: a bare ActivateWindow(1118) (no CustomDialogSettingsItems set)
         opens the TinyPPI overlay font picker. Any caller that sets the property
         first (all the existing Appearance settings buttons) is unaffected. -->
    <onload condition="String.IsEmpty(Window(Home).Property(CustomDialogSettingsItems))">SetProperty(CustomDialogSettingsTitle,TinyPPI Font,Home)</onload>
    <onload condition="String.IsEmpty(Window(Home).Property(CustomDialogSettingsItems))">SetProperty(CustomDialogSettingsItems,DialogCustom_Settings_Items_TinyPPIFont,Home)</onload>
    <controls>
        <include content="DialogCustom_Favourites">
            <param name="id">8000</param>
            <param name="header">$INFO[Window(Home).Property(CustomDialogSettingsTitle)]</param>
            <param name="include_content">DialogCustom_Settings_Items</param>
            <param name="include_list">DialogCustom_Settings_Grouplist</param>
            <param name="resize">![String.IsEqual(Window(Home).Property(CustomDialogSettingsItems),DialogCustom_Settings_Items_BackgroundStyle) | String.IsEqual(Window(Home).Property(CustomDialogSettingsItems),DialogCustom_Settings_Items_Indicators) | String.IsEqual(Window(Home).Property(CustomDialogSettingsItems),DialogCustom_VideoOSD_Items) | String.IsEqual(Window(Home).Property(CustomDialogSettingsItems),DialogCustom_VideoInfo_Items) | String.IsEqual(Window(Home).Property(CustomDialogSettingsItems),DialogCustom_Buttons_Items) | String.IsEqual(Window(Home).Property(CustomDialogSettingsItems),DialogCustom_u3k_Items)]</param>
        </include>
    </controls>
</window>
