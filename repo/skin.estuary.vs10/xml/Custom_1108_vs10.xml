<?xml version="1.0" encoding="utf-8"?>
<window type="dialog" id="1108">
	<defaultcontrol always="true">111000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<height>570</height>
			<centertop>50%</centertop>
			<width>700</width>
			<visible>Player.Process(videohwdecoder)</visible>
			<visible>!Window.IsActive(DialogSettings.xml) + !Window.IsActive(DialogSlider.xml) + !Window.IsActive(GameVideoFilter) + !Window.IsActive(GameStretchMode) + !Window.IsActive(GameControllers) + !Window.IsActive(GameVideoRotation)</visible>
			<animation effect="fade" time="200">VisibleChange</animation>
			<include content="DialogBackgroundCommons">
				<param name="width" value="700" />
				<param name="height" value="80" />
				<param name="header_label" value="$INFO[Window(home).Property(settingslist_Header)]" />
				<param name="header_id" value="1" />
			</include>
			<control type="group" id="111000">
				<left>0</left>
				<top>80</top>
				<control type="grouplist" id="111100">
					<visible>String.IsEqual(window(home).Property(settingslist_content),osd)</visible>
					<width>700</width>
					<height>490</height>
					<itemgap>0</itemgap>
					<onup>111000</onup>
					<ondown>111000</ondown>
					<orientation>vertical</orientation>
					<control type="button" id="111111">
						<width>700</width>
						<include>DialogSettingButton</include>
						<label>Original (Dolby Vision)</label>
						<onclick>RunScript(script.tinyppi,run_mode,original_dv)</onclick>
						<onclick>Close</onclick>
			            <visible>String.Contains(VideoPlayer.HdrType,dolby)</visible>
					</control>
					<control type="button" id="1111112">
						<width>700</width>
						<include>DialogSettingButton</include>
						<label>Original (HDR)</label>
						<onclick>RunScript(script.tinyppi,run_mode,original_hdr)</onclick>
						<onclick>Close</onclick>
			            <visible>String.IsEqual(VideoPlayer.HdrType,hdr10)</visible>
					</control>
					<control type="button" id="1111113">
						<width>700</width>
						<include>DialogSettingButton</include>
						<label>Original (SDR)</label>
						<onclick>RunScript(script.tinyppi,run_mode,original_sdr)</onclick>
						<onclick>Close</onclick>
			            <visible>String.IsEmpty(VideoPlayer.HdrType)</visible>
					</control>
					<control type="button" id="1111114">
						<width>700</width>
						<include>DialogSettingButton</include>
						<label>$VAR[Label_VideoHDRCodec] -&gt; HDR 10</label>
						<onclick>RunScript(script.tinyppi,run_mode,original_hdr)</onclick>
						<onclick>Close</onclick>
			            <visible>String.IsEmpty(VideoPlayer.HdrType)</visible>
					</control>
					<control type="button" id="111021">
						<width>700</width>
						<include>DialogSettingButton</include>
						<label>$VAR[Label_VideoHDRCodec] -&gt; SDR</label>
						<onclick>RunScript(script.tinyppi,run_mode,sdr8)</onclick>
						<onclick>Close</onclick>
			            <visible>String.IsEqual(VideoPlayer.HdrType,hdr10) | String.Contains(VideoPlayer.HdrType,dolby)</visible>
					</control>
					<control type="button" id="111041">
						<width>700</width>
						<include>DialogSettingButton</include>
						<label>$VAR[Label_VideoHDRCodec] -&gt; Dolby Vision</label>
						<onclick>RunScript(script.tinyppi,run_mode,dv)</onclick>
						<onclick>Close</onclick>
			            <visible>String.IsEqual(VideoPlayer.HdrType,hdr10) | String.IsEmpty(VideoPlayer.HdrType)</visible>
					</control>
					<control type="button" id="1110003">
						<width>700</width>
						<include>DialogSettingButton</include>
						<label>Player infos</label>
						<onclick>runscript(script.tinyppi)</onclick>
						<onclick>Close</onclick>
					</control>
				</control>
			</control>
		</control>
	</controls>
</window>